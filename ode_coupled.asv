function dy = ode_coupled(~, y, vars, fine_ode_boolean, plot_case, type)

% DESCRIPTION:
%   ODE accoppiata pressione-camera + regressione mesh.
%
% Stato:
%   y(1)     = pressione camera pc [Pa]
%   y(2:end) = mesh [x1...xn, y1...yn]
%
% plot_case:
%   "refined" -> usa refine_mesh_v3 per valutare area/perimetro
%   "ode45"   -> usa direttamente la mesh grezza
%
% Nota:
%   La mesh raffinata viene usata per valutare area/perimetro.
%   La dinamica vera della mesh resta calcolata sulla mesh grezza Y.

%% ============================================================
%  1. UNPACK STATO
% ============================================================

pc = y(1);          % [Pa]
Y  = y(2:end);
Y  = Y(:);

%% ============================================================
%  2. UNPACK VARS
% ============================================================

% geometry
L  = vars.geometry.grain_length;
At = vars.geometry.throat_area;

idx_v=vars.geometry.idx_v;

idx_v_interni = vars.geometry.idx_v_interni;

% fuel
a_rf  = vars.fuel.a_rf;
n_rf  = vars.fuel.n_rf;
rho_f = vars.fuel.rho_f;

% combustion
mdot_ox = vars.combustion.mdot_ox;
Tc_fun  = vars.combustion.Tc_fun;
R_fun   = vars.combustion.R_fun;
k_fun   = vars.combustion.k_fun;

%% ============================================================
%  3. VALUTAZIONE MESH GREZZA
% ============================================================
% Prima valuto la mesh grezza per ottenere una prima stima di Gox e rf.
% Questa rf serve alla refine istantanea.

P_raw = stato_to_punti_locale(Y);

[~, Ap_raw] = eval_mesh(P_raw, "cartesian");

if Ap_raw <= 0
    error("Area portante non positiva in ode_coupled.");
end

Gox_raw = mdot_ox / Ap_raw;
rf = a_rf * Gox_raw^n_rf;

%% ============================================================
%  4. EVENTUALE RAFFINAMENTO MESH CORRENTE
% ============================================================
% Il raffinamento viene controllato direttamente da plot_case.
%
% plot_case = "refined" -> raffina la mesh per area/perimetro
% plot_case = "ode45"   -> non raffina

switch plot_case

    case "refined"


        P_eval = refine_mesh_v3(P_raw, idx_v_interni)
        Y_eval = punti_to_stato_locale(P_eval);

    case "ode45"

        P_eval = P_raw;
        Y_eval = Y;

    otherwise

        error('plot_case non valido in ode_coupled. Usa "refined" oppure "ode45".');

end

%% ============================================================
%  5. AREA, PERIMETRO E REGRESSIONE SULLA MESH SCELTA
% ============================================================

[perimB, Ap] = eval_mesh(P_eval, "cartesian");

if Ap <= 0
    error("Area portante valutata non positiva in ode_coupled.");
end

Gox = mdot_ox / Ap;
rf = a_rf * Gox^n_rf;

Ab = perimB * L;

mdot_f  = rho_f * Ab * rf;
mdot_in = mdot_f + mdot_ox;

O_F = mdot_ox / mdot_f;

%% ============================================================
%  6. USCITA UGELLO
% ============================================================

pc_bar = pc * 1e-5;

Tc = Tc_fun(O_F, pc_bar);
R  = R_fun(O_F, pc_bar);
k  = k_fun(O_F, pc_bar);

K2 = k * ((2/(k+1))^((k+1)/(k-1)));

cstar = sqrt(R * Tc / K2);

mdot_out = pc * At / cstar;

rho_g = pc / (R * Tc);

%% ============================================================
%  7. DINAMICA MESH
% ============================================================
% La dinamica vera della mesh viene calcolata sulla mesh grezza Y.
% ode_mesh_v4 è la versione aggiornata:
% - tutti i punti regrediscono normalmente
% - solo le punte interne vengono trattate come intersezione dei lati

dY = ode_mesh_v4(0, Y, idx_v_interni, rf);

%% ============================================================
%  8. DERIVATE AREA/PERIMETRO PER EQUAZIONE DI PRESSIONE
% ============================================================
% Queste vengono calcolate sulla stessa mesh usata per valutare
% area e perimetro, cioè Y_eval.

dY_eval = ode_mesh_v4(0, Y_eval, idx_v_interni, rf);

[d_perim_perim, d_area_area, dperimeter, darea] = ...
    ode_eval_mesh(Y_eval, dY_eval);

%% ============================================================
%  9. EQUAZIONE PRESSIONE CAMERA
% ============================================================

vars.geometry.grain_length = L;
vars.geometry.port_area = Ap;
vars.geometry.d_area_area = d_area_area;

if fine_ode_boolean

    dRTdOF_fun_OF_p = vars.combustion.dRTdOF_fun_OF_p;
    dRTdp_fun_OF_p  = vars.combustion.dRTdp_fun_OF_p;

    dRTdOF = dRTdOF_fun_OF_p(O_F, pc_bar);
    dRTdp  = dRTdp_fun_OF_p(O_F, pc_bar);

    deltapc = pc_bar * dRTdp  / (R * Tc);
    deltaOF = O_F    * dRTdOF / (R * Tc);

    fine_ode.deltapc = deltapc;
    fine_ode.deltaOF = deltaOF;
    fine_ode.n_rf = n_rf;
    fine_ode.d_perim_perim = d_perim_perim;

    dp_p = ode_chamber_pressure( ...
        mdot_in, ...
        mdot_out, ...
        rho_g, ...
        vars, ...
        fine_ode);

else

    dp_p = ode_chamber_pressure( ...
        mdot_in, ...
        mdot_out, ...
        rho_g, ...
        vars);

end

dp = dp_p * pc;

%% ============================================================
%  10. ASSEMBLAGGIO OUTPUT
% ============================================================

dy = [dp; dY(:)];

end


%% ============================================================
%  FUNZIONE LOCALE: STATO -> PUNTI
% ============================================================

function P = stato_to_punti_locale(Y)

Y = Y(:);

n = length(Y)/2;

x = Y(1:n);
y = Y(n+1:end);

P = [x y];

end


%% ============================================================
%  FUNZIONE LOCALE: PUNTI -> STATO
% ============================================================

function Y = punti_to_stato_locale(P)

x = P(:,1);
y = P(:,2);

Y = [x; y];

end